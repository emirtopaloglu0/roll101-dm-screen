<div class="r101-template">
  <div class="r101-box-actions">
    <button type="button" class="r101-header-button r101-toggle-all" data-action="toggleSections"
            data-tooltip="R101DMSCREEN.Template.ToggleAll" aria-label="{{localize 'R101DMSCREEN.Template.ToggleAll'}}">
      <i class="fa-solid {{#if open}}fa-angles-up{{else}}fa-angles-down{{/if}}" aria-hidden="true"></i>
    </button>
    {{#if variants}}
    <select class="r101-select" data-r101-template="variant" aria-label="{{localize 'R101DMSCREEN.Template.Variant'}}">
      {{#each variants}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
    </select>
    {{/if}}
    {{#if langs}}
    <select class="r101-select" data-r101-template="lang" aria-label="{{localize 'R101DMSCREEN.Template.Language'}}">
      {{#each langs}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
    </select>
    {{/if}}
  </div>
  <div class="r101-scroll r101-template-body">
    {{#each sections}}
    <details class="r101-tpl-section" {{#if ../open}}open{{/if}}>
      <summary>{{title}}</summary>
      <table class="r101-tpl-table">
        {{#if columns.length}}
        <thead><tr>{{#each columns}}<th scope="col">{{this}}</th>{{/each}}</tr></thead>
        {{/if}}
        <tbody>
          {{#each rows}}<tr>{{#each this}}<td>{{this}}</td>{{/each}}</tr>{{/each}}
        </tbody>
      </table>
      {{#if note}}<p class="r101-note r101-tpl-note">{{note}}</p>{{/if}}
    </details>
    {{/each}}
    {{#if attribution}}<p class="r101-attribution">{{attribution}}</p>{{/if}}
  </div>
</div>
