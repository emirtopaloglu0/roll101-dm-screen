<div class="r101-screen" style="--r101-cols: {{layout.cols}}; --r101-rows: {{layout.rows}}; --r101-font-scale: {{font.value}};">
  <nav class="r101-tabs" aria-label="{{localize 'R101DMSCREEN.Layout.Tabs'}}">
    {{#each tabs}}
    <button type="button" class="r101-tab{{#if active}} r101-active{{/if}}" data-action="switchLayout"
            data-layout-id="{{id}}" draggable="true" aria-pressed="{{#if active}}true{{else}}false{{/if}}"
            data-tooltip="R101DMSCREEN.Layout.TabHint">{{name}}</button>
    {{/each}}
    <button type="button" class="r101-tab-tool" data-action="addLayout"
            data-tooltip="R101DMSCREEN.Layout.Add" aria-label="{{localize 'R101DMSCREEN.Layout.Add'}}">
      <i class="fa-solid fa-plus" aria-hidden="true"></i>
    </button>
    <button type="button" class="r101-tab-tool" data-action="duplicateLayout"
            data-tooltip="R101DMSCREEN.Layout.Duplicate" aria-label="{{localize 'R101DMSCREEN.Layout.Duplicate'}}">
      <i class="fa-solid fa-clone" aria-hidden="true"></i>
    </button>
    {{#if canDeleteLayout}}
    <button type="button" class="r101-tab-tool" data-action="deleteLayout"
            data-tooltip="R101DMSCREEN.Layout.Delete" aria-label="{{localize 'R101DMSCREEN.Layout.Delete'}}">
      <i class="fa-solid fa-trash" aria-hidden="true"></i>
    </button>
    {{/if}}
  </nav>
  <header class="r101-toolbar">
    <label class="r101-field">
      <span>{{localize "R101DMSCREEN.Toolbar.Columns"}}</span>
      <select data-r101-setting="cols">{{selectOptions colChoices selected=layout.cols}}</select>
    </label>
    <span class="r101-times" aria-hidden="true">×</span>
    <label class="r101-field">
      <span>{{localize "R101DMSCREEN.Toolbar.Rows"}}</span>
      <select data-r101-setting="rows">{{selectOptions rowChoices selected=layout.rows}}</select>
    </label>
    <label class="r101-field r101-font" data-tooltip="R101DMSCREEN.Toolbar.FontSizeHint">
      <i class="fa-solid fa-text-height" aria-hidden="true"></i>
      <input type="range" data-r101-setting="fontScale" min="{{font.min}}" max="{{font.max}}" step="{{font.step}}"
             value="{{font.value}}" aria-label="{{localize 'R101DMSCREEN.Toolbar.FontSize'}}">
      <span class="r101-font-value">{{font.percent}}%</span>
    </label>
    {{#if hiddenText}}
    <span class="r101-note"><i class="fa-solid fa-eye-slash" aria-hidden="true"></i> {{hiddenText}}</span>
    {{/if}}
    {{#if readOnly}}
    <span class="r101-note r101-warning"><i class="fa-solid fa-lock" aria-hidden="true"></i> {{localize "R101DMSCREEN.Toolbar.ReadOnly"}}</span>
    {{/if}}
    <span class="r101-toolbar-end">
      <button type="button" class="r101-tab-tool" data-action="exportLayouts"
              data-tooltip="R101DMSCREEN.IO.Export" aria-label="{{localize 'R101DMSCREEN.IO.Export'}}">
        <i class="fa-solid fa-file-export" aria-hidden="true"></i>
      </button>
      <button type="button" class="r101-tab-tool" data-action="importLayouts"
              data-tooltip="R101DMSCREEN.IO.Import" aria-label="{{localize 'R101DMSCREEN.IO.Import'}}">
        <i class="fa-solid fa-file-import" aria-hidden="true"></i>
      </button>
      <button type="button" class="r101-tab-tool" data-action="managePacks"
              data-tooltip="R101DMSCREEN.Packs.Title" aria-label="{{localize 'R101DMSCREEN.Packs.Title'}}">
        <i class="fa-solid fa-box-archive" aria-hidden="true"></i>
      </button>
      <button type="button" class="r101-tab-tool" data-action="restoreBackup"
              data-tooltip="R101DMSCREEN.Backup.Title" aria-label="{{localize 'R101DMSCREEN.Backup.Title'}}">
        <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>
      </button>
    </span>
  </header>

  <div class="r101-grid">
    {{#each cells}}
    {{#if box}}
    <section class="r101-box r101-box-{{box.type}}{{#if box.historyOpen}} r101-show-history{{/if}}"
             style="grid-column: {{col}} / span {{colSpan}}; grid-row: {{row}} / span {{rowSpan}};"
             data-col="{{col}}" data-row="{{row}}" data-col-span="{{colSpan}}" data-row-span="{{rowSpan}}"
             data-box-id="{{box.id}}" data-box-type="{{box.type}}">
      <header class="r101-box-header">
        <span class="r101-drag-handle" draggable="true" data-tooltip="R101DMSCREEN.Box.Move">
          <i class="fa-solid fa-grip-vertical" aria-hidden="true"></i>
        </span>
        <input class="r101-box-title" type="text" value="{{box.title}}" maxlength="{{@root.titleMaxLength}}"
               placeholder="{{box.placeholder}}" data-r101-field="title"
               aria-label="{{localize 'R101DMSCREEN.Box.Title'}}">
        {{#if box.hasHistory}}
        <button type="button" class="r101-header-button" data-action="toggleHistory"
                data-tooltip="R101DMSCREEN.History.Toggle" aria-label="{{localize 'R101DMSCREEN.History.Toggle'}}"
                aria-pressed="{{#if box.historyOpen}}true{{else}}false{{/if}}">
          <i class="fa-solid fa-clipboard-list" aria-hidden="true"></i>
        </button>
        {{/if}}
      </header>
      <div class="r101-box-body">
      <div class="r101-main-view">
      {{#if box.missing}}
      <div class="r101-missing" role="alert">
        <i class="fa-solid fa-link-slash" aria-hidden="true"></i>
        <p>{{box.missingText}}</p>
        <p class="r101-note">{{localize "R101DMSCREEN.Box.ReconnectHint"}}</p>
      </div>
      {{else if box.isNotes}}
      <textarea class="r101-notes" data-r101-field="text" spellcheck="false"
                placeholder="{{localize 'R101DMSCREEN.Box.NotesPlaceholder'}}">{{box.text}}</textarea>
      {{else if box.journal}}
      {{> "modules/roll101-dm-screen/templates/boxes/journal.hbs" box.journal}}
      {{else if box.table}}
      {{> "modules/roll101-dm-screen/templates/boxes/table.hbs" box.table}}
      {{else if box.folder}}
      {{> "modules/roll101-dm-screen/templates/boxes/folder.hbs" box.folder}}
      {{else if box.coins}}
      {{> "modules/roll101-dm-screen/templates/boxes/coins.hbs" box.coins}}
      {{else if box.template}}
      {{> "modules/roll101-dm-screen/templates/boxes/template.hbs" box.template}}
      {{else if box.glossary}}
      {{> "modules/roll101-dm-screen/templates/boxes/glossary.hbs" box.glossary}}
      {{else if box.generator}}
      {{> "modules/roll101-dm-screen/templates/boxes/generator.hbs" box.generator}}
      {{else if box.loot}}
      {{> "modules/roll101-dm-screen/templates/boxes/loot.hbs" box.loot}}
      {{else if box.actors}}
      {{> "modules/roll101-dm-screen/templates/boxes/actors.hbs" box.actors}}
      {{else}}
      <p class="r101-unsupported">{{localize "R101DMSCREEN.Box.Unsupported"}}</p>
      {{/if}}
      </div>
      {{#if box.hasHistory}}
      <div class="r101-history-view">
        {{> "modules/roll101-dm-screen/templates/boxes/history.hbs" box.history}}
      </div>
      {{/if}}
      </div>
      {{!-- Last in DOM so Tab goes title -> text -> remove. CSS places it in the header. --}}
      <button type="button" class="r101-icon-button" data-action="removeBox"
              data-tooltip="R101DMSCREEN.Box.Remove" aria-label="{{localize 'R101DMSCREEN.Box.Remove'}}">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
      <span class="r101-resize-handle" data-tooltip="R101DMSCREEN.Box.Resize" aria-hidden="true"></span>
    </section>
    {{else}}
    <section class="r101-box r101-empty" style="grid-column: {{col}}; grid-row: {{row}};" data-col="{{col}}" data-row="{{row}}">
      <button type="button" class="r101-add" data-action="addNotes">
        <i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "R101DMSCREEN.Box.AddNotes"}}
      </button>
      <button type="button" class="r101-add" data-action="openLibrary">
        <i class="fa-solid fa-book" aria-hidden="true"></i> {{localize "R101DMSCREEN.Library.Open"}}
      </button>
      <p class="r101-drop-hint">{{localize "R101DMSCREEN.Box.DropHint"}}</p>
    </section>
    {{/if}}
    {{/each}}
  </div>
</div>
