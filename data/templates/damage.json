          "rows": [
            [
              {
                "en": "Improvised weapon",
                "tr": "Doğaçlama silah"
              },
              {
                "en": "No Proficiency Bonus to hit. 1d4 damage of a fitting type. Thrown: 20/60 ft. If it looks like a real weapon, the GM may use that weapon's rules (a table leg as a Club). Also applies to a Ranged weapon used in melee or a Melee weapon thrown without the Thrown property.",
                "tr": "İsabete Yetkinlik Bonusu eklenmez. Uygun türde 1d4 hasar. Fırlatma: 20/60 ft. Gerçek bir silaha benziyorsa GM o silahın kurallarını kullanabilir (masa ayağı = Club). Yakın dövüşte kullanılan uzak silah ve Thrown özelliği olmadan fırlatılan yakın silah da buna girer."
              }
            ],
            [
              {
                "en": "Falling",
                "tr": "Düşme"
              },
              {
                "en": "1d6 Bludgeoning per 10 ft, max 20d6.",
                "tr": "Her 10 ft için 1d6 Bludgeoning, en fazla 20d6."
              }
            ],
            [
              {
                "en": "Burning",
                "tr": "Yanma"
              },
              {
                "en": "1d4 Fire at the start of each of its turns. Action: drop Prone and roll to put it out. Also ends if doused, submerged or smothered.",
                "tr": "Her turunun başında 1d4 Fire. Aksiyon: Prone olup yuvarlanarak söndür. Islanırsa, suya batarsa veya boğulursa da söner."
              }
            ],
            [
              {
                "en": "Critical Hit",
                "tr": "Kritik vuruş"
              },
              {
                "en": "Roll all the attack's damage dice twice, then add modifiers.",
                "tr": "Saldırının tüm hasar zarlarını iki kez at, sonra değiştiricileri ekle."
              }
            ],
            [
              {
                "en": "Resistance / Vulnerability",
                "tr": "Direnç / Zafiyet"
              },
              {
                "en": "Damage of that type is halved (round down) / doubled. Each applies once per instance.",
                "tr": "O türdeki hasar yarıya iner (aşağı yuvarla) / ikiye katlanır. Her biri bir hasarda bir kez uygulanır."
              }
            ],
            [
              {
                "en": "Immunity",
                "tr": "Bağışıklık"
              },
              {
                "en": "No damage of that type.",
                "tr": "O türde hasar alınmaz."
              }
            ],
            [
              {
                "en": "Damage threshold",
                "tr": "Hasar eşiği"
              },
              {
                "en": "Only damage equal to or above the threshold in a single hit is taken; smaller hits do nothing.",
                "tr": "Tek seferde eşiğe eşit veya üstü hasar alınır; daha küçük vuruşlar etkisizdir."
              }
            ]
          ]
        },
